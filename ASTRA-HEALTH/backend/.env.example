# Copy this file to .env (optional - the app runs fine without it for local use)
APP_SECRET=replace-with-a-long-random-secret
# Relative sqlite paths are resolved inside the backend/ folder
DATABASE_URL=sqlite:///./astravault.db
# Only needed if you bypass the Vite proxy and call the API directly from another origin
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Bundled 17-domain trained-model inference is enabled by default.
ML_MODE=trained
